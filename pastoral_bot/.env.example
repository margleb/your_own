# Set only PASTORAL_* variables; do not reuse personal bot credentials.
PASTORAL_TELEGRAM_TOKEN=
PASTORAL_OPENROUTER_API_KEY=
PASTORAL_DATABASE_URL=postgresql+asyncpg://pastoral:CHANGE_ME@127.0.0.1:5543/pastoral
# Optional for run, required for live eval: same shared budget DB used by the public bot.
# Keep this pointing to pastoral when DATABASE_URL points to pastoral_eval.
PASTORAL_BUDGET_DATABASE_URL=
PASTORAL_STATE_DIR=/var/lib/pastoral-bot
PASTORAL_MODEL=google/gemini-2.5-flash
PASTORAL_DAILY_ANSWER_LIMIT=10
PASTORAL_DAILY_BUDGET_USD=5
PASTORAL_CONCURRENCY=4
# Upper accepted provider prices, USD per 1M tokens. Requests above them fail closed.
PASTORAL_INPUT_PRICE_PER_MILLION=0.30
PASTORAL_OUTPUT_PRICE_PER_MILLION=2.50
PASTORAL_CAMPAIGNS=telega_prayers,telega_dating
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PASTORAL_BACKUP_KEY=
# Only for the isolated PostgreSQL Compose service; choose different strong passwords.
PASTORAL_POSTGRES_ADMIN_PASSWORD=
PASTORAL_DATABASE_PASSWORD=
